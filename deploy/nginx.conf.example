server {
    listen 80;
    server_name evergreen.example.com www.evergreen.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name evergreen.example.com www.evergreen.example.com;

    ssl_certificate /etc/letsencrypt/live/evergreen.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evergreen.example.com/privkey.pem;

    client_max_body_size 6m;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location ^~ /uploads/ {
        alias /var/www/evergreen/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
