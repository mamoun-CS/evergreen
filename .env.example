DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/evergreen"

# npm run build applies pending migrations to this database before building.
# Configure the server's target database here/in its environment. See deploy/README.md.

# Owner account — set strong, unique values before running the app.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Email delivery (SMTP) — required for password-reset and order-notification emails.
# Ask your email provider for these values; never commit the real .env file.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Evergreen <no-reply@example.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Lahza card payments — omit the secret to keep card checkout unavailable.
# Obtain this secret from the Lahza merchant dashboard; never expose it to client code.
LAHZA_SECRET_KEY="replace-with-your-lahza-secret-key"
# Defaults to https://api.lahza.io when omitted.
LAHZA_BASE_URL="https://api.lahza.io"
# Defaults to ${NEXT_PUBLIC_APP_URL}/payment/lahza/callback when omitted.
LAHZA_CALLBACK_URL="http://localhost:3000/payment/lahza/callback"

# Local uploads are suitable only for persistent-disk deployments.
UPLOAD_STORAGE_DRIVER="local"
UPLOAD_DIR="/var/www/evergreen/uploads"

# Required only when abandoned-cart campaigns have customer consent and a secure scheduler.
ABANDONED_CART_EMAILS_ENABLED="false"
PAYMENT_RECONCILIATION_SECRET="replace-with-a-random-32-byte-secret"

# Shared PostgreSQL rate limiting. Configure TRUSTED_IP_HEADER only when a
# reverse proxy overwrites it (for example "x-real-ip"). Limits are per scope.
TRUSTED_IP_HEADER=""
RATE_LIMIT_AUTH_MAX="20"
RATE_LIMIT_AUTH_WINDOW_SECONDS="900"
RATE_LIMIT_REGISTRATION_MAX="5"
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS="3600"
RATE_LIMIT_PASSWORD_RESET_MAX="5"
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS="3600"
RATE_LIMIT_PAYMENT_MAX="8"
RATE_LIMIT_PAYMENT_WINDOW_SECONDS="900"
RATE_LIMIT_WRITE_MAX="30"
RATE_LIMIT_WRITE_WINDOW_SECONDS="3600"
RATE_LIMIT_BROWSE_MAX="180"
RATE_LIMIT_BROWSE_WINDOW_SECONDS="60"
