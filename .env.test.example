# ================================================================
# Ever Green — Test Environment Variables (TEMPLATE)
# ================================================================
# Copy this file to .env.test for local testing only.
# NEVER commit .env.test. NEVER point DATABASE_URL_TEST at production.
# ================================================================

# DATABASE URL for isolated PostgreSQL test container ONLY.
# Must point to 127.0.0.1:5433 with database name starting "evergreen_test".
# The test guard will reject any URL that does not meet these rules.
DATABASE_URL_TEST="postgresql://evergreen_test:test-only-do-not-use-in-production@127.0.0.1:5433/evergreen_test"

# SMTP for test email delivery (Mailcatcher or local sink)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="test@example.test"

# Application URL for test emails and redirects
NEXT_PUBLIC_APP_URL="http://localhost:3107"

# Trusted IP header for rate-limit tests (matches integration test header)
TRUSTED_IP_HEADER="x-test-ip"

# Session secret for tests only
ADMIN_SESSION_SECRET="test-secret-do-not-use-in-production-32-bytes"

# Rate limit configuration overrides for faster tests
RATE_LIMIT_ORDER_CLAIM_MAX="5"
RATE_LIMIT_ORDER_CLAIM_WINDOW_SECONDS="60"
RATE_LIMIT_ORDER_CLAIM_CONFIRM_MAX="20"
RATE_LIMIT_ORDER_CLAIM_CONFIRM_WINDOW_SECONDS="15"
