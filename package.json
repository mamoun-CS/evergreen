{
  "name": "evergreen-store",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-build.mjs && next build",
    "db:deploy": "prisma migrate deploy",
    "build:check": "node scripts/prepare-build.mjs --check",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "catalog:fix": "tsx prisma/scripts/fix-evergreen-catalog.ts",
    "catalog:translate": "tsx prisma/scripts/translate-catalog-ar-en.ts",
    "catalog:prepare-translations": "tsx prisma/scripts/prepare-approved-translations.ts",
    "catalog:organize-categories": "tsx scripts/organize-catalog-categories.ts",
    "products:import": "tsx scripts/import-products.ts",
    "products:optimize-images": "tsx scripts/optimize-product-images.ts",
    "products:export-texts": "tsx scripts/export-product-texts.ts",
    "products:import-texts": "tsx scripts/import-product-texts.ts",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:e2e": "node tests/e2e/storefront.cjs",
    "test:e2e:checkout": "node tests/e2e/checkout-idempotency.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
